# all = local UI+checks | dashboard = Render UI only | worker = local BMS checks → Render
ROLE=all

BMS_URL=https://in.bookmyshow.com/movies/coimbatore/ramayana/buytickets/ET00523959/20261119?etCodes=ET00523959&language=tamil&refEventCode=ET00523959
TARGET_DATES=2026-11-20,2026-11-19
CINEMA_NAME=Broadway Cinemas
FORMAT_HINT=IMAX
POLL_INTERVAL_MS=60000
PORT=3847

# Worker → Render (required when ROLE=worker)
REPORT_URL=https://YOUR-SERVICE.onrender.com
INGEST_SECRET=change-me-to-a-long-random-string

# Push (same keys on Render + generate with npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
